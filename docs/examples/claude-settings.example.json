{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NO_PROXY": "localhost,127.0.0.1",
    "no_proxy": "localhost,127.0.0.1",
    "MCP_TIMEOUT": "120000",
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(**/*)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet format*)",
      "Bash(dotnet restore*)",
      "Bash(dotnet run*)",
      "Bash(dotnet tool*)",
      "Bash(dotnet dev-certs*)",
      "Bash(tasklist*)",
      "Bash(netstat*)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(docker ps*)",
      "Bash(docker info*)",
      "Bash(docker version*)",
      "Bash(docker logs*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "PowerShell(dotnet build*)",
