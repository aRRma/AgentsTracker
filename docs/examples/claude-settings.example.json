      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "PowerShell(git push *)",
      "PowerShell(git checkout*)",
      "PowerShell(git restore*)",
      "PowerShell(git clean*)",
