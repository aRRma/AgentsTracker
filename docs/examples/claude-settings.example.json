      "PowerShell(git switch --discard-changes*)",
      "PowerShell(git switch -C*)",
      "PowerShell(git branch --delete --force*)",
      "PowerShell(git stash pop*)",
      "PowerShell(git worktree remove*)",
      "PowerShell(git worktree prune*)",
      "PowerShell(git -C * push *)",
      "PowerShell(git -C * checkout*)",
      "PowerShell(git -C * restore*)",
      "PowerShell(git -C * clean*)",
      "PowerShell(git -C * switch -f*)",
      "PowerShell(git -C * switch --force*)",
      "PowerShell(git -C * switch --discard-changes*)",
      "PowerShell(git -C * switch -C*)",
      "PowerShell(git -C * branch -D*)",
