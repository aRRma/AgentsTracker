      "PowerShell(git -C * stash pop*)",
      "PowerShell(git -C * stash drop*)",
      "PowerShell(git -C * stash clear*)",
      "PowerShell(git -C * worktree remove*)",
      "PowerShell(git -C * worktree prune*)",
      "PowerShell(Remove-Item*)",
      "PowerShell(Stop-Process*)",
      "PowerShell(Stop-ScheduledTask*)",
      "PowerShell(Unregister-ScheduledTask*)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)"
