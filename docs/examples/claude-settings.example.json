      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.git-credentials)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local*)",
      "Edit(//**/.env.prod*)",
      "Edit(//**/.env.production*)",
      "Edit(~/.ssh/**)",
      "Bash(curl*)",
      "Bash(wget*)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Start-BitsTransfer *)",
      "PowerShell(curl.exe*)",
      "PowerShell(wget.exe*)",
      "Bash(rm -rf .git*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
