# Скопируйте в .env рядом и заполните. Файл в .gitignore: в нём токен бота.
# DPAPI в контейнере не работает, поэтому секреты живут здесь, а не в appsettings.Local.json.

# Токен от @BotFather. Настройки канала живут в Gateway:Channel:Settings.
Gateway__Channel__Settings__BotToken=123456789:AA...

# Кому можно управлять ботом. Свой id узнаете из лога после первой попытки написать боту:
#   docker compose logs -f gateway
Gateway__Channel__Settings__AllowedUserIds__0=123456789

# Папка с репозиториями на хосте: она монтируется в /projects.
PROJECTS_DIR=C:/Users/me/source/repos

# Проект по умолчанию — имя папки внутри /projects.
PROJECT=MyRepo

# Порт монитора на хосте (внутри контейнера всегда 5100).
MONITOR_PORT=5100

# Прокси, если Telegram недоступен напрямую.
# Gateway__Proxy=http://user:pass@host:2080
