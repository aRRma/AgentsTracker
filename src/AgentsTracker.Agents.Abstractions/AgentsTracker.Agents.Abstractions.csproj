    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AgentsTracker.Agents</RootNamespace>
  </PropertyGroup>

  <!-- Ради IServiceCollection, IConfiguration, ILogger и IEndpointRouteBuilder в контракте модуля:
