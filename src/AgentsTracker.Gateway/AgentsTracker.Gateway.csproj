<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Номер выпуска приходит из тега: релизная сборка передаёт -p:Version. Здесь остаётся
         пометка сборки из исходников — иначе монитор и чат показали бы «1.0.0» от SDK
         и локальная сборка выглядела бы выпущенной версией. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Features\Monitor\index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <!-- Единственное место, где хост знает о конкретном агенте и канале, — выбор модулей в Program.cs. -->
  <ItemGroup>
    <ProjectReference Include="..\AgentsTracker.Agents.Abstractions\AgentsTracker.Agents.Abstractions.csproj" />
    <ProjectReference Include="..\AgentsTracker.Agents.Claude\AgentsTracker.Agents.Claude.csproj" />
    <ProjectReference Include="..\AgentsTracker.Channels.Abstractions\AgentsTracker.Channels.Abstractions.csproj" />
    <ProjectReference Include="..\AgentsTracker.Channels.Telegram\AgentsTracker.Channels.Telegram.csproj" />
  </ItemGroup>

</Project>
